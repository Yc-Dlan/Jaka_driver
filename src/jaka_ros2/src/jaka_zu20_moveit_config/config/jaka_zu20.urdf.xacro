<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jaka_zu20">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="use_gazebo" default="false"/>
    <xacro:arg name="use_rviz_sim" default="false"/>

    <xacro:include filename="$(find jaka_description)/urdf/jaka_zu20.urdf" />

    <xacro:include filename="jaka_zu20.ros2_control.xacro" />

    <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro" />

    <xacro:jaka_zu20_ros2_control name="jaka_zu20_hardware" initial_positions_file="$(arg initial_positions_file)" use_gazebo="$(arg use_gazebo)" use_rviz_sim="$(arg use_rviz_sim)" />

    <xacro:robotiq_gripper name="RobotiqGripperHardwareInterface" prefix="" parent="Link_06" use_fake_hardware="$(arg use_rviz_sim)" sim_ignition="$(arg use_gazebo)">
        <origin xyz="0 0 0" rpy="0 0 0" /> 
    </xacro:robotiq_gripper>

</robot>